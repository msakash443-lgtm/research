#!/bin/sh
# Refuse a push while Alembic has more than one head. Enable once per clone:
#   git config core.hooksPath scripts/hooks
root=$(git rev-parse --show-toplevel) || exit 1
for py in "$root/.venv/Scripts/python.exe" "$root/.venv/bin/python"; do
    [ -x "$py" ] && break
    py=
done
exec "${py:-python}" "$root/scripts/check_alembic_heads.py"
