# Local development uses the Postgres service from docker-compose.yml. Production
# values belong in your host's secret manager, never in this file.
DATABASE_URL=postgresql+psycopg://research_ai:change-me@localhost:5432/research_ai
ENVIRONMENT=development
SESSION_SECRET=replace-with-a-long-random-value-at-least-32-characters
PUBLIC_ORIGIN=http://localhost:8000
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
CORS_ORIGINS=[]
AUTO_CREATE_SCHEMA=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Configure any OpenAI-compatible chat-completions service to enable synthesis.
# Leave these blank to use the source/evidence workspace without LLM calls.
# Local Ollama: run `ollama serve` and `ollama pull llama3.2:3b`
LLM_API_KEY=ollama
LLM_API_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=120
RESEARCH_RUN_LIMIT_PER_DAY=20
# true is convenient when running uvicorn locally. Set false with the worker in Docker/production.
RUN_RESEARCH_INLINE=true
RESEARCH_WORKER_POLL_SECONDS=2
MAX_REQUEST_BODY_BYTES=26214400
# Used only by Docker Compose for its local development database.
POSTGRES_DB=research_ai
POSTGRES_USER=research_ai
POSTGRES_PASSWORD=change-me
