# Copy to .env and edit. Never commit .env or put real secrets in this file.

# --- Local PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=research_ai
POSTGRES_USER=research_ai
POSTGRES_PASSWORD=change-me-local-only

# --- Core app ---
ENVIRONMENT=development
# Must be a random value of 32+ characters in production.
SESSION_SECRET=replace-with-a-long-random-value
PUBLIC_ORIGIN=http://localhost:8000
# Must be false in production (use Alembic migrations).
AUTO_CREATE_SCHEMA=true
# Non-Docker local run only; the Docker worker handles queued runs otherwise.
RUN_RESEARCH_INLINE=false
RESEARCH_RUN_LIMIT_PER_DAY=20
# Lower daily cap for runs that also use web/scholar retrieval.
RESEARCH_RUN_RETRIEVAL_LIMIT_PER_DAY=5
# Total model tokens one project may use before further calls are refused (0 = no limit).
PROJECT_TOKEN_BUDGET=0
RESEARCH_WORKER_POLL_SECONDS=2
# General task queue: a running task must heartbeat within this many seconds or it is reaped.
TASK_LEASE_SECONDS=300
# Retry delay after a failed attempt: base * 2^(attempt-1), capped.
TASK_RETRY_BASE_SECONDS=5
TASK_RETRY_MAX_SECONDS=300
MAX_REQUEST_BODY_BYTES=1048576

# --- Google sign-in (required in production) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- LLM (OpenAI-compatible chat/completions) ---
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_SCHEMA_MAX_ATTEMPTS=3
# AI pre-screen (M2.2): an answer below this confidence (0-1) is recorded as "maybe" instead of include/exclude.
PRESCREEN_MIN_CONFIDENCE=0.6
# Thematic clustering (M3.8.1): off while EMBEDDING_MODEL is empty. Titles and abstracts are sent to
# the /embeddings endpoint at EMBEDDING_API_BASE_URL (default: LLM_API_BASE_URL, with LLM_API_KEY).
EMBEDDING_MODEL=
EMBEDDING_API_BASE_URL=
EMBEDDING_BATCH_SIZE=64
CLUSTER_MAX_SOURCES=1000

# --- Local/self-hosted LLM (optional; OpenAI-compatible, e.g. vLLM/Ollama/LM Studio) ---
# Used only via OpenAICompatibleLLM.for_participant_data() for prompts that may contain
# participant/sensitive data (consent text, raw responses, transcripts). Must be set
# together or not at all. Most local servers need no API key.
LOCAL_LLM_API_KEY=
LOCAL_LLM_API_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT_SECONDS=120
# LOCAL_LLM_API_BASE_URL must be a local/private host: loopback, 10.x/172.16-31.x/192.168.x, link-local,
# localhost, *.local, *.internal, or a single-label name such as a Docker service (`http://ollama:11434/v1`).
# Anything else is refused at startup. Set true only if it is your own server on a public address.
LOCAL_LLM_ALLOW_PUBLIC_HOST=false
# Safe default: true. Participant-data calls fail loudly instead of silently reaching
# LLM_API_BASE_URL when no local model is configured. Set false only after an explicit
# decision that the third-party model above may see participant data (plan.md Q4).
PARTICIPANT_DATA_REQUIRES_LOCAL_MODEL=true

# --- Object storage for PDFs/full text ---
# Only "local" is implemented. Stored objects are write-once. docker-compose.yml points the root
# at a shared volume so the web and worker containers see the same files.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_ROOT=./data/objects
OBJECT_STORAGE_MAX_BYTES=52428800
# Open-access full-text fetch (M2.7.1; needs `unpaywall` in CONNECTORS_ENABLED and CONNECTOR_CONTACT_EMAIL).
# A PDF is stored only when Unpaywall reports one of these licences; otherwise only the link is kept.
# The download is capped at OBJECT_STORAGE_MAX_BYTES and refused for private/internal addresses.
FULLTEXT_STORE_LICENCES=["cc0","pd","public-domain","cc-by","cc-by-sa","cc-by-nd","cc-by-nc","cc-by-nc-sa","cc-by-nc-nd"]
FULLTEXT_FETCH_TIMEOUT_SECONDS=60
# PDF text extraction (M2.7.3): PDFs with more pages are refused, not parsed.
FULLTEXT_MAX_PAGES=2000

# --- ARC web retrieval (off by default; separate HTTP service) ---
ARC_RETRIEVAL_ENABLED=false
# HTTPS and a token of 16+ characters are required in production when enabled.
ARC_RETRIEVAL_BASE_URL=
ARC_RETRIEVAL_TOKEN=
ARC_RETRIEVAL_TIMEOUT_SECONDS=120
ARC_MAX_WEB_RESULTS=8
ARC_MAX_SCHOLAR_RESULTS=5
ARC_MAX_CRAWL_URLS=5
# Scholarly connectors: comma-free JSON list of names from connectors/access.py, e.g. ["openalex","crossref"]. Empty = all off.
CONNECTORS_ENABLED=[]
# Scraping-type connectors stay off unless this is true (check each service's terms first).
CONNECTORS_ALLOW_SCRAPING=false
# Contact email for scholarly APIs' polite pool (OpenAlex). Leave empty if unset; do not use a placeholder.
CONNECTOR_CONTACT_EMAIL=
# Optional Semantic Scholar API key; leave empty to use the shared (slow) pool.
SEMANTIC_SCHOLAR_API_KEY=
# Optional NCBI E-utilities key for `pubmed` (more requests per second).
NCBI_API_KEY=
# Required for `core` (free key from https://core.ac.uk/services/api); there is no anonymous access.
CORE_API_KEY=
# Optional OpenCitations access token for `opencitations`.
OPENCITATIONS_ACCESS_TOKEN=

# Seconds scholarly-connector replies may be reused from memory (0 = off; a repeat lookup then never hits the network).
CONNECTOR_CACHE_TTL_SECONDS=0
