{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gold set (X.15)",
  "type": "object",
  "required": ["topic", "supplied_by", "papers"],
  "additionalProperties": false,
  "properties": {
    "topic": {"type": ["string", "null"], "description": "Field/topic; null until Q10 is answered"},
    "supplied_by": {"type": ["string", "null"], "description": "Scholar who hand-labelled the data"},
    "papers": {"type": "array", "items": {"$ref": "#/$defs/paper"}}
  },
  "$defs": {
    "paper": {
      "type": "object",
      "required": ["id", "title", "label", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "doi": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "abstract": {"type": ["string", "null"]},
        "label": {"enum": ["include", "exclude"]},
        "known_relevant": {"type": "boolean", "description": "Part of the ~20 known-relevant set"},
        "reason": {"type": "string", "minLength": 1},
        "extraction": {
          "type": ["object", "null"],
          "description": "Scholar-verified extraction; field name -> {value, source_quote}",
          "additionalProperties": {
            "type": "object",
            "required": ["value", "source_quote"],
            "properties": {"value": {}, "source_quote": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
